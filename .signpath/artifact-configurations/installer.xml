<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "installer": PC-Remote-Setup-<version>.exe,
     as uploaded by .github/workflows/release.yml (a GitHub artifact is a zip). -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="PC-Remote-Setup-${version}.exe" product-name="PC Remote" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
